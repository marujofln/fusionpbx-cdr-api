# Keycloak Configuration
KEYCLOAK_SERVER_URL=https://sso.example.com
KEYCLOAK_REALM=your-realm-name
KEYCLOAK_AUDIENCE=your-client-id-or-resource
KEYCLOAK_ALGORITHMS=RS256
# Tokens must carry KEYCLOAK_AUDIENCE in aud. Legacy tokens issued before the
# audience mapper was added have no aud; list their client IDs (azp) here,
# comma-separated, until they are reissued. Leave empty once all are reissued.
KEYCLOAK_ALLOWED_CLIENTS=

# Database Configuration (FusionPBX)
FUSIONPBX_DB_HOST=localhost
FUSIONPBX_DB_PORT=5432
FUSIONPBX_DB_NAME=fusionpbx
FUSIONPBX_DB_USER=fusionpbx
FUSIONPBX_DB_PASSWORD=your_password
FUSIONPBX_DB_SCHEMA=public

# Application Configuration
APP_DEBUG=False
APP_LOG_LEVEL=INFO
APP_PORT=3001
# Server URI for audio URLs (optional - will be auto-generated from request if not set)
# APP_SERVER_URI=http://localhost:8000
# Recording path - APP_RECORDING_PATH takes precedence over FUSIONPBX_RECORDING_PATH
APP_RECORDING_PATH=/var/lib/fusionpbx/recordings
FUSIONPBX_RECORDING_PATH=/var/lib/fusionpbx/recordings

# CORS Configuration
ALLOWED_ORIGINS=["http://localhost:3000", "https://example.com"]

# Caddy Configuration
API_HOST=cdr.api.example.com
CADDY_UPSTREAM=api:3001
