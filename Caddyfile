# Caddy reverse proxy configuration
# HTTPS reverse proxy with automatic SSL certificate provisioning
# Hostname configurable via API_HOST env var (defaults to cdr.api.example.com)

{$API_HOST} {
    # Reverse proxy to the API service (configurable via CADDY_UPSTREAM env var)
    reverse_proxy {$CADDY_UPSTREAM} {
        # Preserve original request headers
        header_up Host {host}
        header_up X-Real-IP {remote}
        header_up X-Forwarded-For {remote}
        header_up X-Forwarded-Proto {scheme}
        
        # WebSocket support
        header_up Connection {>Connection}
        header_up Upgrade {>Upgrade}
    }
    
    # Basic logging
    log {
        output stdout
        format console
    }
}


